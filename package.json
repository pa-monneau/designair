{
  "name": "designair",
  "version": "0.2.15",
  "private": true,
  "description": "Lib UI React partagée entre les apps (Record'air, Home'air, Bi'air), publiée sous le scope npm historique @recordair.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "storybook": "node scripts/run-with-node24.mjs storybook:inner",
    "storybook:inner": "npm run build && storybook dev -p 6006 --no-open",
    "build-storybook": "node scripts/run-with-node24.mjs build-storybook:inner",
    "build-storybook:inner": "npm run build && storybook build && node scripts/verify-storybook-bundle.mjs",
    "test": "node scripts/run-with-node24.mjs test:inner",
    "test:inner": "npm run build && npm run test:clear-cache && vitest run --project=storybook",
    "test:watch": "node scripts/run-with-node24.mjs test:watch:inner",
    "test:watch:inner": "npm run build && npm run test:clear-cache && vitest --project=storybook",
    "test:coverage": "node scripts/run-with-node24.mjs test:coverage:inner",
    "test:coverage:inner": "npm run build && npm run test:clear-cache && vitest run --project=storybook --coverage",
    "test:clear-cache": "rm -rf node_modules/.cache/storybook/*/*/sb-vitest",
    "pack:dry-run": "npm pack --cache .npm-cache --workspaces --dry-run",
    "release:publish": "bash scripts/publish-packages.sh"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.5.4",
    "@storybook/addon-docs": "^10.5.4",
    "@storybook/addon-vitest": "^10.5.10",
    "@storybook/react-vite": "^10.5.4",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "playwright": "^1.62.1",
    "postcss": "^8.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "storybook": "^10.5.4",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
